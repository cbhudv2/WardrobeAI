# Runtime secrets: set real values only in a protected local/VPS .env.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_DAILY_CHAT_ID=123456789
MISTRAL_API_KEY=replace-me

# Runtime configuration
APP_ENV=production
LOG_LEVEL=INFO
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
DATABASE_PATH=/data/wardrobe.sqlite3
BACKUP_DIR=/backups
LEGACY_WARDROBE_PATH=/app/legacy_data/wardrobe.json
LEGACY_HISTORY_PATH=/app/legacy_data/outfit_history.json
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=zai-glm-5-3-flash
MISTRAL_REASONING_EFFORT=low
WEATHER_BASE_URL=https://api.open-meteo.com/v1
WEATHER_LATITUDE=42.4304
WEATHER_LONGITUDE=19.2594
WEATHER_LOCATION_NAME=Podgorica
APP_TIMEZONE=Europe/Podgorica
DAILY_SUGGESTION_TIME=07:00
DAILY_SUGGESTION_WEEKDAYS=MON,TUE,WED,THU,FRI

# Compose configuration
IMAGE_TAG=replace-with-git-sha
DEPLOY_HOST_PORT=3000

